# ==============================================================================
# MAHREEN OS - KONFIGURASI API KEY PETA NUSANTARA
# ==============================================================================
# Anda dapat memilih salah satu penyedia API di bawah ini (atau gunakan OpenStreetMap
# Indonesia yang 100% GRATIS tanpa butuh API Key sama sekali).

# 1. OpenStreetMap Indonesia (OSM ID):
#    -> SUDAH TERPASANG & AKTIF OTOMATIS: 100% GRATIS TANPA API KEY

# 2. Ina-Geoportal BIG (Badan Informasi Geospasial RI / Peta Rupabumi Indonesia):
#    Portal Resmi Geospasial Nasional: https://tanahair.indonesia.go.id

# 3. Geoapify API (Khusus Batas Wilayah Indonesia - Free 3.000 req/hari):
#    Dapatkan di: https://www.geoapify.com/
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# 4. Google Maps Platform API Key (Citra Satelit & Peta Jalan):
#    Dapatkan di: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 5. Mapbox Public Access Token (Custom Cartography):
#    Dapatkan di: https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=
